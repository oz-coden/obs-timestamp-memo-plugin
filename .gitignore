# Exclude everything
/*

# Except for default project files
!/.github
!/build-aux
!/cmake
!/data
!/src
!/tests
!/docs
!.clang-format
!.gersemirc
!.gitignore
!buildspec.json
!CMakeLists.txt
!CMakePresets.json
!LICENSE
!README.md
!SPEC.md
!CHANGELOG.md

# Local handoff, reviews and validation logs; keep these off the remote.
/HANDOFF.md

# Exclude lock files
*.lock.json

# Python release tooling caches
__pycache__/

# Exclude macOS legacy resource forks
.DS_Store

# Exclude CMake build number cache
/cmake/.CMakeBuildNumber
